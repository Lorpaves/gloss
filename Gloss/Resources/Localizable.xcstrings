    "选中文字即可翻译，可在菜单栏 %@ 中打开设置。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select text to translate it. Open Settings from %@ in the menu bar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選取文字即可翻譯，可在選單列 %@ 中打開設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストを選択すると翻訳できます。メニューバーの %@ から設定を開けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트를 선택하면 바로 번역할 수 있습니다. 메뉴 막대의 %@ 에서 설정을 여세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez du texte pour le traduire. Ouvrez les réglages depuis %@ dans la barre des menus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiere Text zum Übersetzen. Öffne die Einstellungen über %@ in der Menüleiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona texto para traducirlo. Abre los ajustes desde %@ en la barra de menús."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione texto para traduzir. Abra os ajustes em %@ na barra de menus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выделите текст для перевода. Открыть настройки можно через %@ в строке меню."
          }
        }
      }
    },
